        "/api/user-data/backup/{module}": {
            "post": {
                "security": [
                    {
                        "ApiKeyAuth": []
                    }
                ],
                "description": "接收模块 JSON 数据与图片文件并保存",
                "consumes": [
                    "multipart/form-data"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "user-data"
                ],
                "summary": "备份指定模块的数据",
                "parameters": [
                    {
                        "type": "string",
                        "description": "模块名称",
                        "name": "module",
                        "in": "path",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "JSON 字段集合，键名对应目标文件名（不含扩展名）",
                        "name": "jsonData",
                        "in": "formData",
                        "required": true
                    },
                    {
                        "type": "file",
                        "description": "待上传的图片文件（可多文件）",
                        "name": "files",
                        "in": "formData"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        },
        "/api/user-data/check-images/{module}": {
            "post": {
                "security": [
                    {
                        "ApiKeyAuth": []
                    }
                ],
                "description": "接收文件名列表，返回哪些已存在、哪些缺失（用于增量上传）",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "user-data"
                ],
                "summary": "检查图片文件是否已存在于服务端",
                "parameters": [
                    {
                        "type": "string",
                        "description": "模块名称",
                        "name": "module",
                        "in": "path",
                        "required": true
                    },
                    {
                        "description": "待检查的文件名列表",
                        "name": "body",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/data_handler.CheckImagesRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/data_handler.CheckImagesResponse"
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        },
        "/api/user-data/sync/{module}": {
            "get": {
                "security": [
                    {
                        "ApiKeyAuth": []
                    }
                ],
                "description": "读取指定模块的所有数据（DB 表或 JSON 文件），合并后返回",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "user-data"
                ],
                "summary": "同步指定模块的数据",
                "parameters": [
                    {
                        "type": "string",
                        "description": "模块名称",
                        "name": "module",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "成功返回合并后的JSON数据",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    },
                    "404": {
                        "description": "模块未找到",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    },
                    "500": {
                        "description": "服务器内部错误",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        }
    },
