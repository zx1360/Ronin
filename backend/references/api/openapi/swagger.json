                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "文件类型: file | thumb | preview",
                        "name": "type",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "file"
                        }
                    },
                    "400": {
