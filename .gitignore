**/.flutter-plugins-dependencies
**/.packages
**/.metadata

# Dart
**/.dart_tool/
**/.pub/

# Go 编译产物
*.exe
*.test
*.out

# 测试覆盖率
**/coverage/

# 环境变量文件（绝对不要提交）
.env
.env.*